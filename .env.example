# HealthCompass Environment Configuration

# Chat Provider Configuration
# Default: groq (uses Groq API for answer generation)
CHAT_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Embedding Provider Configuration
# Default: local (uses sentence-transformers, no API key required)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional OpenAI Configuration
# Only required if EMBEDDING_PROVIDER=openai or CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Embedding Batch Configuration
EMBEDDING_BATCH_SIZE=64
MAX_RETRY_ATTEMPTS=3

# Vector Database Configuration
CHROMA_DB_PATH=data/chroma_db
CHROMA_COLLECTION_NAME=healthcompass_documents

# Context Injection Configuration
MAX_CONTEXT_TOKENS=5000
